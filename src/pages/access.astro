---
import Layout from '~/layouts/PageLayout.astro';
import { LINE_OA_URL } from '~/navigation';

const metadata = {
  title: 'アクセス・お問い合わせ',
  description:
    'Skippy English School（大阪市都島区内代町2-2-23）へのアクセス。Osaka Metro谷町線・野江内代駅から徒歩圏。都島・城東・旭エリアから自転車で通えます。お問い合わせはLINEから。',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Skippy English School',
  description: '大阪市都島区内代町のこども英会話教室。まず話す、それから読む。少人数レッスン、無料体験は一年中受付。',
  address: {
    '@type': 'PostalAddress',
    postalCode: '534-0013',
    addressRegion: '大阪府',
    addressLocality: '大阪市都島区',
    streetAddress: '内代町2-2-23',
    addressCountry: 'JP',
  },
  url: 'https://skippyenglish.school',
  telephone: '+81-6-6167-9262',
  email: 'hello@skippyenglish.school',
};
---

<Layout metadata={metadata}>
  <section class="py-14 md:py-20 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <p class="eyebrow-label mb-3">ACCESS & CONTACT</p>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-5">アクセス・お問い合わせ</h1>
      <p class="text-base md:text-lg leading-relaxed max-w-2xl" style="line-height: 2;">
        教室は<span class="marker">都島区内代町</span>にあります。電車なら谷町線・野江内代駅、近くのエリアからは自転車や車が便利です。
      </p>
    </div>
  </section>

  <section class="section-cream py-14 md:py-20 px-6">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <!-- Info -->
      <div class="space-y-5">
        <div class="skippy-card">
          <h2 class="font-extrabold mb-2">住所</h2>
          <p class="text-sm leading-relaxed" style="line-height: 1.9;">
            〒534-0013<br />大阪府大阪市都島区内代町2-2-23
          </p>
        </div>

        <div class="skippy-card">
          <h2 class="font-extrabold mb-3">電車でお越しの場合</h2>
          <ul class="space-y-2 text-sm" style="line-height: 1.9;">
            <li class="flex items-start gap-2">
              <span style="color: var(--skippy-magenta);">●</span>
              <span><span class="font-bold">Osaka Metro 谷町線「野江内代駅」</span>から徒歩圏内。電車の場合はこちらが最寄りです。</span>
            </li>
            <li class="flex items-start gap-2">
              <span style="color: var(--skippy-cyan);">●</span>
              <span><span class="font-bold">JRおおさか東線「JR野江駅」</span>からも歩けますが、お子さんの足には少し距離があります。</span>
            </li>
          </ul>
        </div>

        <div class="skippy-card">
          <h2 class="font-extrabold mb-3">自転車・車でお越しの場合</h2>
          <p class="text-sm leading-relaxed mb-3" style="line-height: 1.9;">
            都島・城東・旭など近くのエリアからは、自転車がいちばん便利です。実際、多くのご家庭が自転車で通っています。
          </p>
          <p class="text-sm leading-relaxed" style="color: var(--skippy-muted); line-height: 1.9;">
            専用駐車場はありません。お車の場合は近隣のコインパーキングをご利用ください。
          </p>
        </div>

        <div class="skippy-card">
          <h2 class="font-extrabold mb-3">お問い合わせ</h2>
          <p class="text-sm leading-relaxed mb-4" style="line-height: 1.9;">
            ご質問・体験のご予約は、LINEがいちばん早くて確実です。
          </p>
          <a href={LINE_OA_URL} target="_blank" rel="noopener noreferrer" class="btn-line w-full">
            <svg width="22" height="22" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M38 20.3C38 13.1 31 7.3 22.4 7.3C13.8 7.3 6.8 13.1 6.8 20.3C6.8 26.7 12.2 32.1 19.7 33.1C20.2 33.2 20.9 33.4 21.1 33.8C21.3 34.2 21.2 34.8 21.1 35.2L20.7 37.4C20.6 37.8 20.3 39 22.4 38.1C24.5 37.2 33.2 31.8 37.1 27.3C38.9 25.3 38 22.5 38 20.3Z" fill="white"/>
            </svg>
            LINEでお問い合わせ・ご予約
          </a>
          <a href="tel:0661679262" class="btn-ghost-light w-full mt-3" style="background: #ffffff;">📞 06-6167-9262</a>
          <a href="mailto:hello@skippyenglish.school" class="btn-ghost-light w-full mt-3" style="background: #ffffff;">✉️ hello@skippyenglish.school</a>
        </div>
      </div>

      <!-- Map -->
      <div class="md:sticky md:top-24">
        <div class="skippy-card !p-2 overflow-hidden">
          <iframe
            src="https://maps.google.com/maps?q=%E5%A4%A7%E9%98%AA%E5%B8%82%E9%83%BD%E5%B3%B6%E5%8C%BA%E5%86%85%E4%BB%A3%E7%94%BA2-2-23&z=16&output=embed"
            width="100%"
            height="440"
            style="border: 0; border-radius: 14px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Skippy English School の地図"
          ></iframe>
        </div>
        <p class="mt-3 text-xs text-center" style="color: var(--skippy-muted);">
          地図をタップすると、Googleマップでルートを確認できます。
        </p>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
