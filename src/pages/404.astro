---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = 'ページが見つかりません | Skippy English School';
---

<Layout metadata={{ title }}>
  <section class="flex items-center min-h-[70vh] p-8 bg-white">
    <div class="max-w-md mx-auto text-center">
      <p class="font-heading font-extrabold text-8xl mb-4" style="color: var(--skippy-cyan);">404</p>
      <h1 class="text-2xl font-extrabold mb-4">ページが見つかりませんでした</h1>
      <p class="text-sm leading-relaxed mb-8" style="color: var(--skippy-muted); line-height: 2;">
        お探しのページは、移動したか、なくなってしまったようです。<br />
        Oops! This page seems to have skipped away.
      </p>
      <div class="flex flex-col gap-3 items-center">
        <a href={getHomePermalink()} class="btn-skippy" style="min-width: 240px;">ホームにもどる</a>
        <a href="/classes" class="btn-ghost-light" style="min-width: 240px;">クラス・スケジュールを見る</a>
      </div>
    </div>
  </section>
</Layout>
