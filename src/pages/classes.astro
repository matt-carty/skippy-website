---
import Layout from '~/layouts/PageLayout.astro';
import { LINE_OA_URL } from '~/navigation';

const year = new Date().getFullYear();

const metadata = {
  title: 'クラス・スケジュール',
  description:
    'スキッピー英会話のクラス紹介と週間スケジュール。ウォンバット（4〜7歳・募集中）、ビルビー、クォッカ、エキドナ（英会話×英検）。レッスン45分＋前後15分の英語フリータイム。',
};

const schedule = [
  { day: '火曜日', slots: [{ time: '17:00–17:45', name: 'Quokka クォッカ' }, { time: '18:00–19:00', name: 'Echidna エキドナ（英会話×英検）' }] },
  { day: '水曜日', slots: [{ time: '18:00–18:45', name: 'Wombat ウォンバット', recruiting: true }] },
  { day: '金曜日', slots: [{ time: '16:30–17:15', name: 'Bilby ビルビー' }, { time: '17:30–18:15', name: 'Quokka クォッカ' }] },
  { day: '土曜日', slots: [{ time: '10:15–11:00', name: 'Bilby ビルビー' }, { time: '11:15–12:00', name: 'Wombat ウォンバット', recruiting: true }] },
];
---

<Layout metadata={metadata}>
  <section class="py-14 md:py-20 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <p class="eyebrow-label mb-3">CLASSES & SCHEDULE</p>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-5">クラスとスケジュール</h1>
      <p class="text-base md:text-lg leading-relaxed max-w-2xl" style="line-height: 2;">
        クラスは年齢ではなく<span class="marker">「その子がいまどの段階か」</span>で決まります。全クラス、マット先生が担当。レッスンは45分、前後15分は教室で自由に過ごせる英語フリータイムです。
      </p>
    </div>
  </section>

  <!-- Class cards -->
  <section class="section-cream py-14 md:py-20 px-6">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="skippy-card relative" style="border: 2px solid var(--skippy-magenta);">
        <span class="absolute -top-3 left-6 rounded-full px-3 py-1 text-xs font-extrabold text-white" style="background: var(--skippy-magenta);">いま募集中 — 各クラス残り3席（{year}年7月現在）</span>
        <h2 class="text-2xl font-extrabold mb-1 mt-3">Wombat ウォンバット</h2>
        <p class="text-sm font-bold mb-3" style="color: var(--skippy-magenta);">4〜7歳 ｜ 水 18:00–18:45 ／ 土 11:15–12:00</p>
        <p class="text-sm leading-relaxed" style="line-height: 1.95;">
          {year}年4月に入った、一番新しい生徒たち。歌と動きで「話す」を始めたばかりの段階なので、今から入っても、みんなとほぼ同じスタートラインに立てます。
        </p>
      </div>

      <div class="skippy-card">
        <h2 class="text-2xl font-extrabold mb-1">Bilby ビルビー</h2>
        <p class="text-sm font-bold mb-3" style="color: var(--skippy-muted);">金 16:30–17:15 ／ 土 10:15–11:00</p>
        <p class="text-sm leading-relaxed" style="line-height: 1.95;">
          2024年ごろに始まったクラス。使える表現がどんどん増えていて、自分から英語で言いたいことを言う練習をしています。
        </p>
      </div>

      <div class="skippy-card">
        <h2 class="text-2xl font-extrabold mb-1">Quokka クォッカ</h2>
        <p class="text-sm font-bold mb-3" style="color: var(--skippy-muted);">火 17:00–17:45 ／ 金 17:30–18:15</p>
        <p class="text-sm leading-relaxed" style="line-height: 1.95;">
          スキッピー歴3〜5年。話す力がしっかり育ったので、フォニックスで「読む」段階に進んでいます。話す→読む、の順番が実際に形になっているクラスです。
        </p>
      </div>

      <div class="skippy-card">
        <h2 class="text-2xl font-extrabold mb-1">Echidna エキドナ</h2>
        <p class="text-sm font-bold mb-3" style="color: var(--skippy-muted);">火 18:00–19:00（60分） ｜ 英会話 × 英検</p>
        <p class="text-sm leading-relaxed" style="line-height: 1.95;">
          話す練習と英検対策を1時間でやる、上級生向けクラス。参加には「読める」ことが条件です。試験のためだけの英語にしない、がスキッピー流。
        </p>
      </div>
    </div>
  </section>

  <!-- Weekly schedule table -->
  <section class="py-14 md:py-20 px-6 bg-white">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-8 text-center">週間スケジュール</h2>
      <div class="space-y-4">
        {schedule.map((d) => (
          <div class="skippy-card !py-5">
            <p class="font-heading font-extrabold mb-3" style="color: var(--skippy-magenta);">{d.day}</p>
            <ul class="space-y-2">
              {d.slots.map((s) => (
                <li class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 text-sm">
                  <span class="font-bold shrink-0" style="min-width: 110px;">{s.time}</span>
                  <span class="font-bold">{s.name}</span>
                  {s.recruiting && <span class="rounded-full px-2 py-0.5 text-xs font-extrabold text-white w-fit" style="background: var(--skippy-magenta);">募集中</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm leading-relaxed text-center" style="color: var(--skippy-muted); line-height: 1.9;">
        各レッスンの前後15分は英語フリータイム。早めに来て、遊んで帰れます。
      </p>
    </div>
  </section>

  <!-- Which class fits -->
  <section class="section-cyan-soft py-14 md:py-20 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-4">うちの子はどのクラス？</h2>
      <p class="text-base leading-relaxed mb-8" style="line-height: 2;">
        4〜7歳なら、募集中のウォンバットクラスへ。それ以外の年齢のお子さんも、まず無料体験でレベルを見て、合うクラスがあるか一緒に確認します。まずはLINEでご相談ください。
      </p>
      <a href={LINE_OA_URL} target="_blank" rel="noopener noreferrer" class="btn-line">
        <svg width="22" height="22" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M38 20.3C38 13.1 31 7.3 22.4 7.3C13.8 7.3 6.8 13.1 6.8 20.3C6.8 26.7 12.2 32.1 19.7 33.1C20.2 33.2 20.9 33.4 21.1 33.8C21.3 34.2 21.2 34.8 21.1 35.2L20.7 37.4C20.6 37.8 20.3 39 22.4 38.1C24.5 37.2 33.2 31.8 37.1 27.3C38.9 25.3 38 22.5 38 20.3Z" fill="white"/>
        </svg>
        LINEで相談・体験予約
      </a>
    </div>
  </section>
</Layout>
