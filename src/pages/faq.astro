---
import Layout from '~/layouts/PageLayout.astro';
import { LINE_OA_URL } from '~/navigation';

const metadata = {
  title: 'よくある質問',
  description:
    'スキッピー英会話へのよくある質問。何歳から通える？月謝は？親が英語を話せなくても大丈夫？途中入会はできる？すべてお答えします。',
};

const faqs = [
  {
    q: '何歳から通えますか？',
    a: '対象は3歳〜18歳です。現在は4歳から14歳までの子どもたちが通っていて、小学生が中心です。いま新メンバーを募集しているのは4〜7歳のウォンバットクラスですが、他の年齢のお子さんもまず体験でレベルを見て、合うクラスがあるかご案内します。',
  },
  {
    q: '月謝以外にかかるお金はありますか？',
    a: 'ありません。月謝¥11,000（月4回）に、宿題アプリの利用料も含まれています。入会金も教材費も0円です。',
  },
  {
    q: '体験レッスンはいつできますか？',
    a: '一年中いつでも、無料でできます。スケジュールに合わせて、通常レッスンに参加していただくか、レッスン前後のフリータイムで個別に体験していただきます。LINEで日程をご相談ください。',
  },
  {
    q: '入会するなら、いつがいいですか？',
    a: 'いちばんのおすすめは4月です。新しいコホートがカリキュラムを最初から一緒に始めるからです。ただ、席があれば年度の途中からでも入会できます。追いつくためのフォローもします。',
  },
  {
    q: '親が英語を話せなくても大丈夫ですか？',
    a: '大丈夫です。通っているご家庭のほとんどがそうです。宿題はアプリで完結するので、おうちで教える必要はありません。',
  },
  {
    q: 'うちの子はシャイなのですが……',
    a: '心配いりません。少人数で、まちがいを正解・不正解で評価しないので、静かな子も自分のペースで声を出し始めます。まず体験で、お子さんの様子を見てみてください。',
  },
  {
    q: 'お休みした場合はどうなりますか？',
    a: 'お休みの際はLINEでご連絡ください。振替については、スケジュールに応じてご相談に応じています。',
  },
  {
    q: '英検には対応していますか？',
    a: 'はい。読める段階に進んだ生徒向けに、英会話と英検対策を組み合わせたエキドナクラス（火曜18:00〜、60分）があります。試験のためだけの英語にしないのがスキッピーの方針です。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout metadata={metadata}>
  <section class="py-14 md:py-20 px-6 bg-white">
    <div class="max-w-3xl mx-auto">
      <p class="eyebrow-label mb-3">FAQ</p>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-10">よくある質問</h1>

      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="skippy-card !p-0 overflow-hidden group">
            <summary class="cursor-pointer list-none p-6 font-bold flex items-start gap-3 text-base">
              <span class="font-heading font-extrabold shrink-0" style="color: var(--skippy-magenta);">Q</span>
              <span>{f.q}</span>
            </summary>
            <div class="px-6 pb-6 pt-0 flex items-start gap-3">
              <span class="font-heading font-extrabold shrink-0" style="color: var(--skippy-cyan);">A</span>
              <p class="text-sm leading-relaxed" style="line-height: 2;">{f.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="text-center mt-12">
        <p class="mb-5 font-bold">ここにない質問は、LINEでどうぞ。</p>
        <a href={LINE_OA_URL} target="_blank" rel="noopener noreferrer" class="btn-line">
          <svg width="22" height="22" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M38 20.3C38 13.1 31 7.3 22.4 7.3C13.8 7.3 6.8 13.1 6.8 20.3C6.8 26.7 12.2 32.1 19.7 33.1C20.2 33.2 20.9 33.4 21.1 33.8C21.3 34.2 21.2 34.8 21.1 35.2L20.7 37.4C20.6 37.8 20.3 39 22.4 38.1C24.5 37.2 33.2 31.8 37.1 27.3C38.9 25.3 38 22.5 38 20.3Z" fill="white"/>
          </svg>
          LINEで質問する
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
