---
import '@fontsource-variable/inter';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=M+PLUS+Rounded+1c:wght@700;800&display=swap"
  rel="stylesheet"
/>

<style is:inline>
  /*
   * Skippy English School — brand system v2
   * From the logo: Cyan #6AE6EE · Magenta #FF00A3 · Navy #302D55
   * Borrowed warmth:  Cream #FFEDDA
   * LINE Green #06C755 (LINE buttons only — never for anything else)
   *
   * Rules:
   *  - Magenta is for CTAs and key emphasis ONLY. If everything is pink, nothing is.
   *  - Cyan is decorative: marker underlines, soft tints, bubbles. Never body text.
   *  - Navy replaces black everywhere.
   */
  :root {
    --aw-font-sans: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Meiryo', sans-serif;
    --aw-font-serif: 'Noto Sans JP', serif;
    --aw-font-heading: 'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif;

    /* Magenta, deepened for WCAG contrast on white */
    --aw-color-primary: rgb(224 0 143);
    --aw-color-secondary: rgb(196 0 126);
    /* Cyan accent */
    --aw-color-accent: rgb(106 230 238);

    --aw-color-text-heading: rgb(48 45 85);
    --aw-color-text-default: rgb(48 45 85);
    --aw-color-text-muted: rgb(110 108 140);
    --aw-color-text-page: rgb(48 45 85);
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-surface-soft: rgb(255 237 218);

    --aw-color-bg-page-dark: rgb(48 45 85);

    /* Skippy tokens */
    --skippy-cyan: #6ae6ee;
    --skippy-cyan-soft: #e9fbfd;
    --skippy-magenta: #e0008f;
    --skippy-magenta-bright: #ff00a3;
    --skippy-navy: #302d55;
    --skippy-cream: #ffedda;
    --skippy-line-green: #06c755;
    --skippy-muted: #6e6c8c;
  }

  ::selection {
    background-color: rgb(106 230 238 / 45%);
  }

  html {
    color-scheme: light;
  }

  body {
    font-family: var(--aw-font-sans);
    background-color: #ffffff;
    color: var(--skippy-navy);
  }

  h1, h2, h3, .font-heading {
    font-family: var(--aw-font-heading);
    color: var(--skippy-navy);
  }

  /* ---- Signature: marker-pen underline (cyan) ---- */
  .marker {
    background-image: linear-gradient(transparent 62%, rgb(106 230 238 / 75%) 62%, rgb(106 230 238 / 75%) 94%, transparent 94%);
    padding: 0 0.08em;
  }
  .marker-magenta {
    background-image: linear-gradient(transparent 62%, rgb(255 0 163 / 30%) 62%, rgb(255 0 163 / 30%) 94%, transparent 94%);
    padding: 0 0.08em;
  }

  /* ---- Signature: speech-bubble eyebrow ---- */
  .bubble-eyebrow {
    display: inline-block;
    position: relative;
    font-family: var(--aw-font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--skippy-navy);
    background: var(--skippy-cyan-soft);
    border: 2px solid var(--skippy-cyan);
    border-radius: 9999px;
    padding: 6px 18px;
  }
  .bubble-eyebrow::after {
    content: '';
    position: absolute;
    left: 24px;
    bottom: -8px;
    width: 12px;
    height: 12px;
    background: var(--skippy-cyan-soft);
    border-right: 2px solid var(--skippy-cyan);
    border-bottom: 2px solid var(--skippy-cyan);
    transform: rotate(45deg) skew(10deg, 10deg);
  }

  /* ---- Announcement speech bubble (bigger sibling of .bubble-eyebrow) ----
   * Rounded rectangle, NOT a pill — so it never reads as a button.
   * Cream + navy = warm notice; cyan/magenta stay reserved for their jobs.
   * Tail points down-left, toward the CTA that follows it. */
  .bubble-notice {
    display: inline-block;
    position: relative;
    color: var(--skippy-navy);
    background: var(--skippy-cyan-soft);
    border: 2px solid var(--skippy-cyan);
    border-radius: 16px;
    padding: 12px 20px;
    line-height: 1.7;
  }
  .bubble-notice::after {
    content: '';
    position: absolute;
    left: 28px;
    bottom: -9px;
    width: 14px;
    height: 14px;
    background: var(--skippy-cyan-soft);
    border-right: 2px solid var(--skippy-cyan);
    border-bottom: 2px solid var(--skippy-cyan);
    transform: rotate(45deg) skew(10deg, 10deg);
  }

  /* ---- LINE CTA (green stays green — users know what LINE looks like) ---- */
  .btn-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background-color: var(--skippy-line-green);
    color: #ffffff;
    font-family: var(--aw-font-sans);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    padding: 16px 28px;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    min-height: 56px;
    box-shadow: 0 4px 14px rgb(6 199 85 / 35%);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .btn-line:hover {
    background-color: #05b34c;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgb(6 199 85 / 45%);
  }

  /* ---- Magenta CTA (non-LINE actions) ---- */
  .btn-skippy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--skippy-magenta);
    color: #ffffff;
    font-family: var(--aw-font-sans);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    padding: 16px 28px;
    border-radius: 9999px;
    text-decoration: none;
    min-height: 56px;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .btn-skippy:hover {
    background-color: var(--aw-color-secondary);
    transform: translateY(-1px);
  }

  /* ---- Ghost / outline button on navy or photo backgrounds ---- */
  .btn-ghost-light {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 9999px;
    border: 2px solid rgb(48 45 85 / 25%);
    color: var(--skippy-navy);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    min-height: 52px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .btn-ghost-light:hover {
    border-color: var(--skippy-magenta);
    color: var(--skippy-magenta);
  }

  /* ---- Header LINE button (compact, in the chrome) ---- */
  .header-line-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--skippy-line-green);
    color: #ffffff;
    font-family: var(--aw-font-heading);
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    padding: 9px 14px;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .header-line-btn:hover {
    background: #05b34c;
  }
  .header-line-btn--lg {
    font-size: 14px;
    padding: 11px 18px;
    gap: 8px;
  }

  /* ---- Section rhythm ---- */
  .section-cream { background-color: var(--skippy-cream); }
  .section-cyan-soft { background-color: var(--skippy-cyan-soft); }
  .section-navy { background-color: var(--skippy-navy); }

  /* ---- Cards ---- */
  .skippy-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 4px 20px rgb(48 45 85 / 8%);
  }

  /* ---- Photo placeholder (until real lesson photos land) ---- */
  .photo-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    border: 2px dashed rgb(106 230 238);
    background: linear-gradient(135deg, var(--skippy-cyan-soft) 0%, #ffffff 100%);
    color: var(--skippy-muted);
    font-size: 14px;
    font-weight: 500;
    min-height: 220px;
    text-align: center;
    padding: 16px;
  }

  /* ---- Eyebrow label (latin, small) ---- */
  .eyebrow-label {
    font-family: var(--aw-font-heading);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--skippy-magenta);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .btn-line, .btn-skippy, .btn-ghost-light { transition: none; }
    .btn-line:hover, .btn-skippy:hover { transform: none; }
  }
</style>
