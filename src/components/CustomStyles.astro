---
import '@fontsource-variable/inter';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600;700&family=Poppins:wght@400;600;700&display=swap"
  rel="stylesheet"
/>

<style is:inline>
  /*
   * Skippy English School — brand palette
   * Warm Blue #4A90E2 · Soft Yellow #FFD166 · LINE Green #06C755
   * Movement Orange #FF8A5B · Charcoal #2D3748 · Warm White #FDFBF7
   */
  :root {
    --aw-font-sans: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Meiryo', sans-serif;
    --aw-font-serif: 'Noto Sans JP', serif;
    --aw-font-heading: 'Poppins', 'Noto Sans JP', sans-serif;

    /* Primary brand: Skippy Warm Blue */
    --aw-color-primary: rgb(74 144 226);
    /* Slightly deeper blue for hover */
    --aw-color-secondary: rgb(52 110 185);
    /* Movement Orange as accent */
    --aw-color-accent: rgb(255 138 91);

    --aw-color-text-heading: rgb(45 55 72);
    --aw-color-text-default: rgb(45 55 72);
    --aw-color-text-muted: rgb(113 128 150);
    --aw-color-text-page: rgb(45 55 72);
    --aw-color-bg-page: rgb(253 251 247);
    --aw-color-surface-soft: rgb(237 242 247);

    --aw-color-bg-page-dark: rgb(26 32 44);

    /* Skippy custom tokens */
    --skippy-blue: #4A90E2;
    --skippy-yellow: #FFD166;
    --skippy-line-green: #06C755;
    --skippy-orange: #FF8A5B;
    --skippy-charcoal: #2D3748;
    --skippy-warm-white: #FDFBF7;
    --skippy-soft-grey: #718096;
    --skippy-light-grey: #EDF2F7;

    ::selection {
      background-color: rgb(74 144 226 / 22%);
    }
  }

  /* Force light-only — no dark mode for this brand */
  html {
    color-scheme: light;
  }

  body {
    font-family: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Meiryo', sans-serif;
    background-color: var(--skippy-warm-white);
  }

  /* LINE CTA button styles */
  .btn-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--skippy-line-green);
    color: #ffffff;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    padding: 16px 24px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.1s ease;
    min-height: 56px;
    width: 100%;
  }

  .btn-line:hover {
    background-color: #05b04d;
    transform: translateY(-1px);
  }

  .btn-line:active {
    transform: translateY(0);
  }

  /* Fixed LINE bottom bar — mobile only */
  .line-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: 56px;
    background-color: var(--skippy-line-green);
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .line-bottom-bar {
      display: none;
    }
  }

  .line-bottom-bar a {
    color: #ffffff;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    justify-content: center;
    padding: 0 16px;
  }

  /* Give page content bottom padding so it clears the fixed bar */
  @media (max-width: 767px) {
    body {
      padding-bottom: 56px;
    }
  }

  /* Skippy heading styles */
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Noto Sans JP', sans-serif;
    color: var(--skippy-charcoal);
  }

  /* Section eyebrow labels use Poppins */
  .eyebrow-label {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--skippy-orange);
  }

  /* Skippy section backgrounds */
  .bg-skippy-blue { background-color: var(--skippy-blue); }
  .bg-skippy-yellow { background-color: var(--skippy-yellow); }
  .bg-skippy-yellow-soft { background-color: rgb(255 209 102 / 20%); }
  .bg-skippy-warm-white { background-color: var(--skippy-warm-white); }
  .bg-skippy-light-grey { background-color: var(--skippy-light-grey); }

  .text-skippy-blue { color: var(--skippy-blue); }
  .text-skippy-orange { color: var(--skippy-orange); }
  .text-skippy-charcoal { color: var(--skippy-charcoal); }
  .text-skippy-muted { color: var(--skippy-soft-grey); }

  /* Comparison table styles */
  .comparison-table th, .comparison-table td {
    padding: 12px 16px;
    font-size: 15px;
    line-height: 1.6;
    border-bottom: 1px solid #e2e8f0;
  }

  .comparison-table th {
    font-weight: 700;
    font-size: 14px;
  }

  /* FAQ accordion */
  .faq-item details summary {
    cursor: pointer;
    list-style: none;
    padding: 16px 0;
    font-weight: 700;
    font-size: 16px;
    color: var(--skippy-charcoal);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
  }

  .faq-item details summary::after {
    content: '+';
    font-size: 20px;
    color: var(--skippy-blue);
    flex-shrink: 0;
    margin-left: 12px;
  }

  .faq-item details[open] summary::after {
    content: '−';
  }

  .faq-item details p {
    padding: 16px 0;
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
    color: var(--skippy-charcoal);
  }
</style>
