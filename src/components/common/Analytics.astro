---
import { ANALYTICS } from 'astrowind:config';

const plausible = ANALYTICS?.vendors?.plausible;
const plausibleDomain = plausible?.domain;
const plausibleSrc = plausible?.src ?? 'https://plausible.io/js/script.js';
---

{
  plausibleDomain ? (
    <>
      <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc}></script>
      <script is:inline>
        window.plausible =
          window.plausible ||
          function () {
            (window.plausible.q = window.plausible.q || []).push(arguments);
          };
      </script>
    </>
  ) : null
}
