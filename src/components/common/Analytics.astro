---
import { ANALYTICS } from 'astrowind:config';

const plausible = ANALYTICS?.vendors?.plausible;
const plausibleDomain = plausible?.domain;
const plausibleSrc = plausible?.src ?? 'https://plausible.io/js/script.js';
---

{plausibleDomain ? <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc}></script> : null}
