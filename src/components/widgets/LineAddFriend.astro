<style>
  .line-fab-wrap {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 50;
  }
  .line-fab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--skippy-line-green);
    color: #ffffff;
    font-family: var(--aw-font-heading);
    font-weight: 800;
    font-size: 14px;
    line-height: 1;
    text-decoration: none;
    padding: 13px 18px;
    border-radius: 9999px;
    border: 3px solid #ffffff;
    box-shadow: 0 6px 22px rgb(48 45 85 / 28%);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
  }
  .line-fab:hover {
    background: #05b34c;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgb(48 45 85 / 35%);
  }
  @media (min-width: 768px) {
    .line-fab-wrap {
      right: 24px;
      bottom: 24px;
    }
    .line-fab {
      font-size: 15px;
      padding: 15px 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line-fab { transition: none; }
    .line-fab:hover { transform: none; }
  }
  @media print {
    .line-fab-wrap { display: none; }
  }
</style>
